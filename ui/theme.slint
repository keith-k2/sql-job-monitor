export global Theme {
    in-out property <int> mode: 0;
    in-out property <bool> system-light: false;
    out property <bool> light: root.mode == 2 || (root.mode == 0 && root.system-light);

    out property <color> bg: root.light ? #f3f5f8 : #10151d;
    out property <color> surface: root.light ? #ffffff : #18212d;
    out property <color> grid: root.light ? #f7f9fc : #151d27;
    out property <color> row-alt: root.light ? #eef2f6 : #141c27;
    out property <color> panel: root.light ? #ffffff : #111821;
    out property <color> menu: root.light ? #ffffff : #202b39;
    out property <color> hover: root.light ? #e6eef6 : #2c3d52;
    out property <color> hover-strong: root.light ? #dce7f2 : #1a2532;
    out property <color> selected: root.light ? #d6e7f8 : #294566;
    out property <color> selected-soft: root.light ? #e8f2fb : #243446;
    out property <color> border: root.light ? #d5dee8 : #2a394b;
    out property <color> border-strong: root.light ? #b4c3d3 : #4b5e74;
    out property <color> line: root.light ? #e1e8ef : #223041;
    out property <color> divider: root.light ? #d8e1ea : #344458;
    out property <color> text: root.light ? #1a2633 : #f4f7fb;
    out property <color> text-strong: root.light ? #121b26 : #f0f4f9;
    out property <color> text-body: root.light ? #243444 : #d5deea;
    out property <color> heading: root.light ? #3e5268 : #b8c5d6;
    out property <color> label: root.light ? #3e5268 : #c8d2df;
    out property <color> muted: root.light ? #5c7084 : #91a2b7;
    out property <color> muted-2: root.light ? #6a7e92 : #8191a5;
    out property <color> faint: root.light ? #7d8fa1 : #8b9aaf;
    out property <color> icon-muted: root.light ? #7d90a3 : #56687d;
    out property <color> error-bg: root.light ? #fdecee : #3b2025;
    out property <color> error-text: root.light ? #a32036 : #ffb7bf;
    out property <color> ok: root.light ? #0f7a42 : #76d69b;
    out property <color> info: root.light ? #1464aa : #63b3ff;
    out property <color> info-soft: root.light ? #1a5c96 : #8dbbe8;
    out property <color> fail: root.light ? #c42840 : #ff7d8b;
    out property <color> warn: root.light ? #8a5a00 : #f2c66d;
    out property <color> splitter: root.light ? #c5d2df : #3c5168;
    out property <color> splitter-active: root.light ? #5d87ad : #8eabc8;
    out property <color> titlebar: root.light ? #ffffff : #10151d;
    out property <string> mode-label: root.mode == 1 ? "Theme: Dark" : root.mode == 2 ? "Theme: Light" : "Theme: Follow system";
}
